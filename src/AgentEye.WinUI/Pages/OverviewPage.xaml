<UserControl
    x:Class="AgentEye.WinUI.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 + 操作 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="总览" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7"
                           Text="尚未刷新" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BtnTogglePause" Content="暂停轮询" Click="BtnTogglePause_Click" />
                <Button x:Name="BtnRefresh" Content="立即刷新" Click="BtnRefresh_Click" />
            </StackPanel>
        </Grid>

        <!-- 行列表 -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsHost" Spacing="8" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
