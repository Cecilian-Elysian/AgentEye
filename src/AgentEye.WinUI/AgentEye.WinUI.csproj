<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>AgentEye</RootNamespace>
    <AssemblyName>AgentEye</AssemblyName>
    <!-- 应用版本:更新检查拿它跟 GitHub release 的 tag 比对 -->
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <!-- 框架依赖发布必须带 RID(原来只在 Platform==x64 时生效,默认 AnyCPU 会发布失败) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 瘦身:运行时用系统装的(.NET 8 Desktop Runtime + Windows App Runtime 1.7),
         产物从 491 文件/166MB 降到 ~30 文件/10MB;换机器需先装这两个运行时 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- 只留简体中文 + 英文,砍掉 83 种语言的卫星资源 -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefaultLanguage>zh-CN</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentEye.Core\AgentEye.Core.csproj" />
  </ItemGroup>

</Project>
