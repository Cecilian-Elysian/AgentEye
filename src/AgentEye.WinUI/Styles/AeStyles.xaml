<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="AeCardCornerRadius">8</x:Double>

    <!-- 头部图标按钮:32×32 透明底圆角 6,承载 FontIcon -->
    <Style x:Key="AeIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="AeKpiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AeCardCornerRadius}" />
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <Style x:Key="AeKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AeTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AeKpiValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AeTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="AeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AeCardCornerRadius}" />
        <Setter Property="Padding" Value="16,10,16,10" />
    </Style>

    <Style x:Key="AeSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
</ResourceDictionary>
